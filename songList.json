import openpyxl
from pathlib import Path


# Chemin vers votre fichier Excel (xlsx)
#file_path = "C:/Users/adeli/Downloads/Party Rankings/Envoi des Sheets/One Piece.xlsx"


def create_sorter(file_path):
    
    wb = openpyxl.load_workbook(file_path)
    ws = wb.active
    
    num_rows = ws.max_row

    ID = []
    Anime = []
    Info = []
    #Type = []
    Hyperlink = []
    MP3 = []


    for i in range(2,num_rows+1):
        ID.append(ws.cell(row=i, column=1).value)

    for i in range(2,num_rows+1):
        Anime.append(ws.cell(row=i, column=2).value)

    #for i in range(2,num_rows+1):
        #Type.append("OP")
        #Type.append(ws.cell(row=i, column=3).value.split()[0])

    for i in range(2,num_rows+1):
        Info.append(ws.cell(row=i, column=4).value)
        #print(Info)
    for i in range(2,num_rows+1):
        Hyperlink.append(ws.cell(row=i, column=4).hyperlink.target)
        #print(Hyperlink)
        
    for i in range(2,num_rows+1):
        MP3.append(ws.cell(row=i, column=5).hyperlink.target)
        #print(Hyperlink)

        
    data = "[\n"

    for i in range(len(Anime)):
        data += "    {\n"
        data += f'        "id": {i + 1},\n'
        data += f'        "anime": "{Anime[i]}",\n'
        data += f'        "name": "{Info[i]}",\n'
        data += f'        "video": "{Hyperlink[i]}",\n'
        if MP3[i]:
            data += f'        "mp3": "{MP3[i]}"\n'
        else:
            data += f'        "mp3": null\n'
        if i < len(Anime) - 1:
            data += "    },\n"
        else:
            data += "    }\n"

    data += "]"
    print(data)
    return data

xlsx_path = Path(".")
xlsx_list = list(xlsx_path.glob("*.xlsx"))

for xlsx in xlsx_list:
    print(xlsx)
    party_rank_name = f'{xlsx.stem}' 
    print(party_rank_name)

    data = create_sorter(xlsx)
    print(data)

    with open(f"sorter {party_rank_name}.txt", "w", encoding="utf-8") as fichier:
        fichier.write(data)
